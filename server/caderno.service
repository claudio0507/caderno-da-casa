[Unit]
Description=Caderno da Casa (controle financeiro da família)
After=network.target

[Service]
User=caderno
Group=caderno
WorkingDirectory=/opt/caderno/app
Environment=CADERNO_BIND=127.0.0.1
Environment=CADERNO_PORT=8765
Environment=CADERNO_TRUST_PROXY=1
ExecStart=/usr/bin/python3 /opt/caderno/app/server/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/caderno/app/data

[Install]
WantedBy=multi-user.target
